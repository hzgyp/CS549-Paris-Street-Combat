// Opt-in actual76 clothing diagnosis. No live mesh/skin query or ordinary input override.
TArray<TSharedPtr<FJsonValue>> SleeveSamples;
TSharedPtr<FJsonObject> SleeveReferences;
double SleeveSampleClock=0;
int32 SleeveShotIndex=0;
struct FSleeveFrameTrace{double Time,Wall,Alpha;FName Action;int32 Update;FVector HandR,HandL;double UpperL,LowerL,UpperR,LowerR;};
TArray<FSleeveFrameTrace> SleeveFrameTrace;
void SleeveTrace(UWorld* W,ACharacter* P){auto* D=Display(W,P);auto* Pose=Cast<UPoseableMeshComponent>(Obj(D,TEXT("Pose")));auto* PC=UGameplayStatics::GetPlayerController(W,0);if(!Pose||!PC)return;FVector Eye;FRotator View;PC->GetPlayerViewPoint(Eye,View);const FTransform Camera(View,Eye);auto Point=[&](const TCHAR* N){return Camera.InverseTransformPosition(Pose->GetSocketLocation(N));};const auto R=Point(TEXT("hand_r")),L=Point(TEXT("hand_l")),UR=Point(TEXT("upperarm_r")),UL=Point(TEXT("upperarm_l")),LR=Point(TEXT("lowerarm_r")),LL=Point(TEXT("lowerarm_l"));SleeveFrameTrace.Add({W->GetTimeSeconds(),FPlatformTime::Seconds(),Num(D,TEXT("SourceTransitionAlpha")),Name(P,TEXT("ActionState")),int32(Num(D,TEXT("NativePoseUpdates"))),R,L,FVector::Distance(UL,LL),FVector::Distance(LL,L),FVector::Distance(UR,LR),FVector::Distance(LR,R)});}
TArray<TSharedPtr<FJsonValue>> SleeveNumbers(std::initializer_list<double> Values){TArray<TSharedPtr<FJsonValue>> A;for(double V:Values)A.Add(MakeShared<FJsonValueNumber>(V));return A;}
TSharedPtr<FJsonObject> SleeveTransform(const FTransform& T){auto O=MakeShared<FJsonObject>();const auto V=T.GetTranslation(),S=T.GetScale3D();const auto Q=T.GetRotation();O->SetArrayField(TEXT("t"),SleeveNumbers({V.X,V.Y,V.Z}));O->SetArrayField(TEXT("q"),SleeveNumbers({Q.X,Q.Y,Q.Z,Q.W}));O->SetArrayField(TEXT("s"),SleeveNumbers({S.X,S.Y,S.Z}));return O;}
TArray<TSharedPtr<FJsonValue>> SleeveTransforms(const TArray<FTransform>& Values){TArray<TSharedPtr<FJsonValue>> A;for(const auto& T:Values)A.Add(MakeShared<FJsonValueObject>(SleeveTransform(T)));return A;}
TSharedPtr<FJsonObject> SleeveReference(USkeletalMesh* Mesh){auto O=MakeShared<FJsonObject>();const auto& R=Mesh->GetRefSkeleton();TArray<TSharedPtr<FJsonValue>> N,P;for(int32 I=0;I<R.GetNum();++I){N.Add(MakeShared<FJsonValueString>(R.GetBoneName(I).ToString()));P.Add(MakeShared<FJsonValueNumber>(R.GetParentIndex(I)));}O->SetStringField(TEXT("mesh"),Mesh->GetPathName());O->SetArrayField(TEXT("names"),N);O->SetArrayField(TEXT("parents"),P);O->SetArrayField(TEXT("local"),SleeveTransforms(R.GetRefBonePose()));return O;}
void SleeveClipReferences(UWorld* W,ACharacter* P){auto* D=Display(W,P);TArray<UAnimSequence*> Clips={Cast<UAnimSequence>(Obj(D,TEXT("HoldingClip"))),LoadObject<UAnimSequence>(nullptr,TEXT("/Game/RifleAnimsetPro/Animations/InPlace/Rifle_Reload_2.Rifle_Reload_2")),LoadObject<UAnimSequence>(nullptr,TEXT("/Game/RifleAnimsetPro/Animations/InPlace/Rifle_Grenade_Throw_Loop.Rifle_Grenade_Throw_Loop"))};TArray<TSharedPtr<FJsonValue>> Rows;for(auto* Clip:Clips){if(!Clip||!Clip->GetSkeleton())continue;auto O=MakeShared<FJsonObject>();auto* Skeleton=Clip->GetSkeleton();const auto& R=Skeleton->GetReferenceSkeleton();TArray<TSharedPtr<FJsonValue>> N,Parents,Modes;for(int32 I=0;I<R.GetNum();++I){N.Add(MakeShared<FJsonValueString>(R.GetBoneName(I).ToString()));Parents.Add(MakeShared<FJsonValueNumber>(R.GetParentIndex(I)));Modes.Add(MakeShared<FJsonValueNumber>(int32(Skeleton->GetBoneTranslationRetargetingMode(I))));}O->SetStringField(TEXT("clip"),Clip->GetPathName());O->SetStringField(TEXT("skeleton"),Skeleton->GetPathName());O->SetArrayField(TEXT("names"),N);O->SetArrayField(TEXT("parents"),Parents);O->SetArrayField(TEXT("local"),SleeveTransforms(R.GetRefBonePose()));O->SetArrayField(TEXT("retarget_modes"),Modes);Rows.Add(MakeShared<FJsonValueObject>(O));}SleeveReferences->SetArrayField(TEXT("clips"),Rows);}
bool SleeveSample(UWorld* W,ACharacter* P,const FString& Label){auto* D=Display(W,P);auto* Pose=Cast<UPoseableMeshComponent>(Obj(D,TEXT("Pose")));auto* Body=P->GetMesh();auto* PC=UGameplayStatics::GetPlayerController(W,0);if(!Pose||!Body||!PC)return false;auto* Mesh=Cast<USkeletalMesh>(Pose->GetSkinnedAsset());if(!Mesh||!Body->GetSkeletalMeshAsset()||Pose->GetComponentSpaceTransforms().Num()!=Mesh->GetRefSkeleton().GetNum())return false;
    if(!SleeveReferences){SleeveReferences=MakeShared<FJsonObject>();SleeveReferences->SetObjectField(TEXT("display"),SleeveReference(Mesh));SleeveReferences->SetObjectField(TEXT("body"),SleeveReference(Body->GetSkeletalMeshAsset()));}
    auto O=MakeShared<FJsonObject>();O->SetStringField(TEXT("label"),Label);O->SetNumberField(TEXT("world_seconds"),W->GetTimeSeconds());O->SetNumberField(TEXT("phase_seconds"),CheckClock);O->SetStringField(TEXT("action"),Name(P,TEXT("ActionState")).ToString());O->SetNumberField(TEXT("grip_alpha"),Num(D,TEXT("HoldingAppliedAlpha")));O->SetNumberField(TEXT("finger_error"),Num(D,TEXT("FingerRotationErrorDegrees")));O->SetArrayField(TEXT("display_local"),SleeveTransforms(Pose->BoneSpaceTransforms));O->SetArrayField(TEXT("display_component"),SleeveTransforms(Pose->GetComponentSpaceTransforms()));O->SetArrayField(TEXT("body_component"),SleeveTransforms(Body->GetComponentSpaceTransforms()));O->SetObjectField(TEXT("display_world"),SleeveTransform(Pose->GetComponentTransform()));FVector Eye;FRotator View;PC->GetPlayerViewPoint(Eye,View);O->SetObjectField(TEXT("camera_world"),SleeveTransform(FTransform(View,Eye)));O->SetNumberField(TEXT("fov"),PC->PlayerCameraManager->GetFOVAngle());O->SetNumberField(TEXT("display_lod"),Pose->GetPredictedLODLevel());O->SetNumberField(TEXT("loaded"),Num(P,TEXT("LoadedAmmo")));O->SetNumberField(TEXT("reserve"),Num(P,TEXT("ReserveAmmo")));SleeveSamples.Add(MakeShared<FJsonValueObject>(O));return true;}
bool SleevePicture(UWorld* W,ACharacter* P,const TCHAR* Name){if(!SleeveSample(W,P,Name))return Expect(W,false,TEXT("sleeve_pose_capture_valid"));if(CheckMode!=TEXT("sleeve_motion"))Picture(*(FString(Name)+TEXT(".png")));return true;}
void SleeveFinish(UWorld* W,bool Pass,const FString& Why){auto O=MakeShared<FJsonObject>();O->SetStringField(TEXT("scope"),TEXT("Original camera/mesh/actions; actual input; existing NPCs held for isolated clothing observation. Bone buffers written after motion; no live skin query."));if(SleeveReferences)O->SetObjectField(TEXT("references"),SleeveReferences);O->SetArrayField(TEXT("samples"),SleeveSamples);FFileHelper::SaveStringToFile(JsonText(O),*(CheckOut/TEXT("POSES.json")),FFileHelper::EEncodingOptions::ForceUTF8WithoutBOM);auto T=MakeShared<FJsonObject>();TArray<TSharedPtr<FJsonValue>> Rows;for(const auto& F:SleeveFrameTrace){auto R=MakeShared<FJsonObject>();R->SetNumberField(TEXT("time"),F.Time);R->SetNumberField(TEXT("wall"),F.Wall);R->SetNumberField(TEXT("alpha"),F.Alpha);R->SetStringField(TEXT("action"),F.Action.ToString());R->SetNumberField(TEXT("update"),F.Update);R->SetArrayField(TEXT("hand_r"),SleeveNumbers({F.HandR.X,F.HandR.Y,F.HandR.Z}));R->SetArrayField(TEXT("hand_l"),SleeveNumbers({F.HandL.X,F.HandL.Y,F.HandL.Z}));R->SetArrayField(TEXT("lengths"),SleeveNumbers({F.UpperL,F.LowerL,F.UpperR,F.LowerR}));Rows.Add(MakeShared<FJsonValueObject>(R));}T->SetArrayField(TEXT("frames"),Rows);FFileHelper::SaveStringToFile(JsonText(T),*(CheckOut/TEXT("FRAME_TRACE.json")),FFileHelper::EEncodingOptions::ForceUTF8WithoutBOM);FinishCheck(W,Pass,Why);}
void SleeveCheck(UWorld* W,AParisBridgeMission* M,FEquipmentSession& S,AParisBridgePlayerController* PC,ACharacter* P,float DT){CheckClock+=DT;SleeveSampleClock+=DT;
    if(CheckStep>0){if(!Flag(Display(W,P),TEXT("Initialized"))){SleeveFinish(W,false,TEXT("display_lost_during_actual_motion"));return;}SleeveTrace(W,P);}
    if(CheckStep>0&&SleeveSampleClock>.05){SleeveSample(W,P,FString::Printf(TEXT("stage_%d"),CheckStep));SleeveSampleClock=0;}
    if(CheckStep==0){if(M->Phase!=TEXT("Ready")||!Flag(Display(W,P),TEXT("Initialized")))return;if(CheckMode==TEXT("sleeve_refs")){if(!SleeveSample(W,P,TEXT("refs_only")))return;SleeveClipReferences(W,P);SleeveFinish(W,true,TEXT("Read-only mesh and action skeleton references; no new motion acceptance"));return;}M->StartMission();HoldBrains(W);PC->SetControlRotation(FRotator(0,0,0));CheckStep=1;CheckClock=0;}
    else if(CheckStep==1&&CheckClock>.7){if(!SleevePicture(W,P,TEXT("01_rifle_ready")))return;Tap(PC,EKeys::LeftMouseButton);CheckStep=2;CheckClock=0;}
    else if(CheckStep==2&&CheckClock>.6){Tap(PC,EKeys::R);CheckStep=3;CheckClock=0;SleeveShotIndex=0;}
    else if(CheckStep==3){const double Times[]={.15,.65,1.2,2.2,3.1};const TCHAR* Names[]={TEXT("02_reload_015"),TEXT("03_reload_065"),TEXT("04_reload_120"),TEXT("05_reload_220"),TEXT("06_reload_310")};if(SleeveShotIndex<5&&CheckClock>Times[SleeveShotIndex]&&!FScreenshotRequest::IsScreenshotRequested()){if(!SleevePicture(W,P,Names[SleeveShotIndex]))return;++SleeveShotIndex;}if(CheckClock>5&&Name(P,TEXT("ActionState"))==TEXT("Ready")){if(!Expect(W,Num(P,TEXT("LoadedAmmo"))==8&&Num(P,TEXT("ReserveAmmo"))==9,TEXT("original_one_shot_reload_conservation")))return;CheckStep=4;CheckClock=0;} }
    else if(CheckStep==4&&CheckClock>.7){if(!SleevePicture(W,P,TEXT("07_rifle_return")))return;WheelInput(PC,true);CheckStep=5;CheckClock=0;}
    else if(CheckStep==5&&CheckClock>.7){if(!SleevePicture(W,P,TEXT("08_frag_ready")))return;PrimaryInput(PC,true);CheckStep=6;CheckClock=0;SleeveShotIndex=0;}
    else if(CheckStep==6){if(SleeveShotIndex==0&&CheckClock>.2){SleevePicture(W,P,TEXT("09_frag_start"));++SleeveShotIndex;}else if(SleeveShotIndex==1&&CheckClock>1.2){SleevePicture(W,P,TEXT("10_frag_hold"));++SleeveShotIndex;}else if(CheckClock>1.7&&!FScreenshotRequest::IsScreenshotRequested()){PrimaryInput(PC,false);CheckStep=7;CheckClock=0;SleeveShotIndex=0;} }
    else if(CheckStep==7){if(SleeveShotIndex==0&&CheckClock>.2){SleevePicture(W,P,TEXT("11_frag_release"));++SleeveShotIndex;}else if(CheckClock>2.4&&S.ThrowKind.IsEmpty()&&Num(Display(W,P),TEXT("HoldingAppliedAlpha"))>.9999){if(!SleevePicture(W,P,TEXT("12_frag_return")))return;WheelInput(PC,false);CheckStep=8;CheckClock=0;} }
    else if(CheckStep==8&&CheckClock>.7){if(!Expect(W,S.SelectedSlot==2,TEXT("actual_smoke_selected")))return;if(!SleevePicture(W,P,TEXT("13_smoke_ready")))return;PrimaryInput(PC,true);CheckStep=9;CheckClock=0;SleeveShotIndex=0;}
    else if(CheckStep==9){if(SleeveShotIndex==0&&CheckClock>.2){SleevePicture(W,P,TEXT("14_smoke_start"));++SleeveShotIndex;}else if(SleeveShotIndex==1&&CheckClock>1.2){SleevePicture(W,P,TEXT("15_smoke_hold"));++SleeveShotIndex;}else if(CheckClock>1.7&&!FScreenshotRequest::IsScreenshotRequested()){PrimaryInput(PC,false);CheckStep=10;CheckClock=0;SleeveShotIndex=0;} }
    else if(CheckStep==10){if(SleeveShotIndex==0&&CheckClock>.2){SleevePicture(W,P,TEXT("16_smoke_release"));++SleeveShotIndex;}else if(CheckClock>2.4&&S.ThrowKind.IsEmpty()&&Num(Display(W,P),TEXT("HoldingAppliedAlpha"))>.9999){if(!SleevePicture(W,P,TEXT("17_final_rifle")))return;CheckStep=11;CheckClock=0;} }
    else if(CheckStep==11&&CheckClock>.5&&!FScreenshotRequest::IsScreenshotRequested()){SleeveFinish(W,SleeveSamples.Num()>100&&S.FragThrown==1&&S.SmokeThrown==1,TEXT("Actual clothing poses and images recorded; requires causal/visual review, not repaired acceptance"));}
    if(CheckClock>15)SleeveFinish(W,false,TEXT("sleeve_stage_timeout"));
}
