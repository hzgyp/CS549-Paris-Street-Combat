// Integrated field-manual checkpoint browser. Data cached while paused; backend revalidates every commit.
void HistoryRefresh(AParisBridgePlayerController* PC){auto& U=State(PC);auto* M=AParisBridgeMission::Find(PC);FString Reason;U.HistoryRows=ParisCheckpointHistory::List(M,Reason);U.Record=FMath::Clamp(U.Record,0,FMath::Max(0,U.HistoryRows.Num()-1));U.CanLoad=!U.HistoryRows.IsEmpty();if(U.HistoryRows.IsEmpty())U.Toast=Reason;}
void HistoryAsk(AParisBridgePlayerController* PC,bool Delete){auto& U=State(PC);if(!U.HistoryRows.IsValidIndex(U.Record))return;const FString SelectedId=U.HistoryRows[U.Record].Id;const int32 SelectedSerial=U.HistoryRows[U.Record].Serial;HistoryRefresh(PC);const int32 Match=U.HistoryRows.IndexOfByPredicate([&](const auto& Row){return Row.Id==SelectedId&&Row.Serial==SelectedSerial;});if(Match==INDEX_NONE){U.Toast=TEXT("Checkpoint changed. Select the record again.");return;}U.Record=Match;const auto& R=U.HistoryRows[U.Record];if(Delete&&R.Latest){U.Toast=TEXT("The latest valid checkpoint is protected.");return;}U.TargetId=R.Id;U.TargetSerial=R.Serial;U.TargetName=R.Id+TEXT("  /  ")+R.Name;U.TargetActive=R.Active;MenuCue(PC,ParisTutorialSoundscape::EMenuCue::Confirm);U.Confirm=Delete?TEXT("HistoryDelete"):TEXT("HistoryLoad");U.ModalChoice=1;U.LastMouse=Ref(PC);}
bool HistoryCommit(AParisBridgePlayerController* PC){auto& U=State(PC);auto* M=AParisBridgeMission::Find(PC);FString Error;if(U.Confirm==TEXT("HistoryDelete")){MenuCue(PC,ParisTutorialSoundscape::EMenuCue::Confirm);const bool Good=ParisCheckpointHistory::Delete(M,U.TargetId,U.TargetSerial,Error);U.Confirm.Empty();U.Toast=Good?(Error.IsEmpty()?TEXT("Old checkpoint removed. Latest checkpoint retained."):Error):Error;HistoryRefresh(PC);U.HistoryAction=0;return true;}if(U.Confirm==TEXT("HistoryLoad")){if(!ParisCheckpointHistory::PrepareLoad(M,U.TargetId,U.TargetSerial,Error)){U.Confirm.Empty();U.Toast=Error;HistoryRefresh(PC);return true;}MenuCue(PC,ParisTutorialSoundscape::EMenuCue::Confirm);Close(PC,false);M->LoadCheckpoint();return true;}return false;}
bool HistoryInput(AParisBridgePlayerController* PC,const FInputKeyEventArgs& A){auto& U=State(PC);if(U.Page!=4||!U.Confirm.IsEmpty())return false;
 if(A.Key==EKeys::Up||A.Key==EKeys::Down){if(U.HistoryRows.Num())U.Record=(U.Record+(A.Key==EKeys::Up?U.HistoryRows.Num()-1:1))%U.HistoryRows.Num();U.HistoryAction=0;U.Toast.Reset();MenuCue(PC,ParisTutorialSoundscape::EMenuCue::Navigate);}
 else if(A.Key==EKeys::Left||A.Key==EKeys::Right){U.HistoryAction=1-U.HistoryAction;MenuCue(PC,ParisTutorialSoundscape::EMenuCue::Navigate);}
 else if(A.Key==EKeys::Enter)HistoryAsk(PC,U.HistoryAction==1);
 else if(A.Key==EKeys::LeftMouseButton){U.SwallowClick=true;const auto P=Ref(PC);for(int I=0;I<U.HistoryRows.Num();++I)if(Hit(P,660,385+I*123,1042,111)){if(U.Record!=I)MenuCue(PC,ParisTutorialSoundscape::EMenuCue::Confirm);U.Record=I;U.HistoryAction=0;return true;}if(Hit(P,660,800,360,52))HistoryAsk(PC,false);else if(Hit(P,1050,800,360,52))HistoryAsk(PC,true);else return false;}
 else return false;return true;
}
void DrawHistory(FPaint& P,AParisBridgePlayerController* PC){auto& U=State(PC);P.Text(TEXT("Select a checkpoint. Loading an older point keeps later saves."),660,347,20,Muted);
 for(int I=0;I<U.HistoryRows.Num();++I){const auto& R=U.HistoryRows[I];const double Y=385+I*123;const bool Selected=I==U.Record;if(Selected){P.Box(655,Y,1052,111,FLinearColor(.10,.13,.10,.6));P.Line(655,Y+4,655,Y+107,Brass,3);}P.Title(R.Id+TEXT("  /  ")+R.Name,678,Y+8,27,Selected?Brass:Ivory);
  FString Stamp=R.Utc;Stamp.ReplaceInline(TEXT("T"),TEXT(" "));P.Text(Stamp+(R.Utc==TEXT("Previous save")?TEXT(""):TEXT("  UTC")),678,Y+46,18,Muted);
  P.Text(FString::Printf(TEXT("SQUAD %d/2   |   RIFLE %d/%d   |   FRAG %d   |   SMOKE %d"),R.Allies,R.Loaded,R.Reserve,R.Frag,R.Smoke),678,Y+76,19,Muted);
  if(R.Latest)P.Label(TEXT("LATEST / PROTECTED"),1430,Y+13,16,Green);if(R.Active)P.Label(TEXT("CURRENT RETRY"),1430,Y+42,16,Brass);if(R.Recovered)P.Label(TEXT("RECOVERED BACKUP"),1430,Y+71,14,Muted);P.Line(660,Y+116,1702,Y+116,Muted);
 }
 if(U.HistoryRows.Num()){P.Button(TEXT("LOAD SELECTED"),660,800,360,U.HistoryAction==0);const bool Protected=U.HistoryRows[U.Record].Latest;if(Protected){P.Outline(1050,800,360,52,Muted);P.Text(TEXT("LATEST SAVE PROTECTED"),1071,815,20,Muted);}else P.Button(TEXT("DELETE OLD SAVE"),1050,800,360,U.HistoryAction==1);}
 else P.Text(TEXT("Reach a checkpoint and save to create your first record."),678,415,23,Muted);
 P.Text(TEXT("UP / DOWN select   |   LEFT / RIGHT action   |   ENTER confirm   |   ESC back"),660,866,18,Muted);
}
