// Included inside the equipment implementation's private namespace.
double SmokeFactor(const FSmoke& C){return FMath::Min(FMath::Clamp((18.-C.Life)/2.,0.,1.),FMath::Clamp(C.Life/3.,0.,1.));}
bool CloudBlock(UWorld* W,const FVector& From,const FVector& To){const auto& S=Session(W);const FVector Delta=To-From;const double Length=Delta.Size();if(Length<1)return false;const FVector Dir=Delta/Length;
    for(const auto& C:S.Clouds){const double Density=SmokeFactor(C);if(Density<.3)continue;const double R=350*Density;const FVector Center=C.Position+FVector(0,0,100);const double Along=FVector::DotProduct(Center-From,Dir);const double DistanceSquared=FVector::DistSquared(From+Dir*Along,Center);if(DistanceSquared>=R*R)continue;const double Half=FMath::Sqrt(R*R-DistanceSquared);const double Chord=FMath::Max(0.,FMath::Min(Length,Along+Half)-FMath::Max(0.,Along-Half));if(Chord*Density>=70)return true;}return false;
}
#include "ParisEquipmentSmoke.inl"
void SmokeVisual(UWorld* W,FSmoke& C){C.Visual=Prop(W,TEXT("Smoke"),C.Position);auto* PS=DenseSmoke(C);auto* E=NewObject<UParticleSystemComponent>(C.Visual.Get());C.Visual->AddInstanceComponent(E);E->SetupAttachment(C.Visual->GetRootComponent());E->SetTemplate(PS);E->SetCollisionEnabled(ECollisionEnabled::NoCollision);E->SetCanEverAffectNavigation(false);E->SetRelativeLocation(FVector(0,0,100));E->SetRelativeScale3D(FVector(1));E->bAutoActivate=true;E->RegisterComponent();C.Effect=E;}
void SmokeTick(UWorld* W,FEquipmentSession& S,float DT){for(int32 I=S.Clouds.Num()-1;I>=0;--I){auto& C=S.Clouds[I];C.Life-=DT;if(C.Effect.IsValid()){const float F=float(SmokeFactor(C));C.Effect->SetFloatParameter(TEXT("Opacity"),.6f*F);C.Effect->SetVectorParameter(TEXT("SmokeColor"),FVector(.72,.73,.70));C.Effect->SetRelativeScale3D(FVector(FMath::Max(.01f,F)));}if(C.Life<=0){if(C.Visual.IsValid())C.Visual->Destroy();Event(W,TEXT("smoke_expired"),C.Id);S.Clouds.RemoveAt(I);}}
    for(auto* C:Combatants(W))if(auto* AI=Cast<AAIController>(C->GetController()))if(auto* BB=AI->GetBlackboardComponent()){auto* Target=Cast<AActor>(BB->GetValueAsObject(TEXT("TargetActor")));if(Target&&CloudBlock(W,C->GetActorLocation()+FVector(0,0,55),Target->GetActorLocation())){BB->SetValueAsBool(TEXT("HasVisibleTarget"),false);if(auto* B=FindFProperty<FBoolProperty>(AI->GetClass(),TEXT("CombatHold")))B->SetPropertyValue_InContainer(AI,false);}}
}
void InstallSight(UWorld* W,FEquipmentSession& S){for(auto* C:Combatants(W)){TArray<UPawnSensingComponent*> Sensors;C->GetComponents(Sensors);for(auto* Sensor:Sensors){bool Exists=false;for(const auto& Bridge:S.Bridges)if(Bridge->Sensor==Sensor)Exists=true;if(Exists)continue;auto* Bridge=NewObject<UParisEquipmentSightBridge>(Sensor);Bridge->Sensor=Sensor;Bridge->Original=Sensor->OnSeePawn;Sensor->OnSeePawn.Clear();Sensor->OnSeePawn.AddDynamic(Bridge,&UParisEquipmentSightBridge::Seen);S.Bridges.Emplace(Bridge);}}}
FString SiteFailure;
bool Site(UWorld* W,FVector XY,FVector& Out){
    SiteFailure.Empty();FCollisionQueryParams Q(SCENE_QUERY_STAT(ParisEquipmentSite),false);for(auto* C:Combatants(W))Q.AddIgnoredActor(C);IgnoreProps(W,Q);FHitResult Hit;
    if(!W->LineTraceSingleByChannel(Hit,FVector(XY.X,XY.Y,500),FVector(XY.X,XY.Y,-300),ECC_Visibility,Q)||Hit.ImpactNormal.Z<.7){SiteFailure=TEXT("ground/normal");return false;}
    Out=Hit.ImpactPoint;auto* Nav=FNavigationSystem::GetCurrent<UNavigationSystemV1>(W);FNavLocation Projected;
    if(!Nav||!Nav->ProjectPointToNavigation(Out,Projected,FVector(35,35,120))||FVector::Dist2D(Out,Projected.Location)>35){SiteFailure=FString::Printf(TEXT("nav_projection floor=%s actor=%s"),*Out.ToString(),*GetNameSafe(Hit.GetActor()));return false;}
    auto* P=UGameplayStatics::GetPlayerCharacter(W,0);const auto* Capsule=P->GetCapsuleComponent();
    TArray<FOverlapResult> Overlaps;W->OverlapMultiByChannel(Overlaps,Out+FVector(0,0,Capsule->GetScaledCapsuleHalfHeight()+1),FQuat::Identity,ECC_Pawn,FCollisionShape::MakeCapsule(Capsule->GetScaledCapsuleRadius(),Capsule->GetScaledCapsuleHalfHeight()),Q);
    for(const auto& Overlap:Overlaps)if(Overlap.bBlockingHit){SiteFailure=FString::Printf(TEXT("standing_capsule floor=%s actor=%s component=%s"),*Out.ToString(),*GetNameSafe(Overlap.GetActor()),*GetNameSafe(Overlap.GetComponent()));return false;}
    auto* Path=Nav->FindPathToLocationSynchronously(W,P->GetActorLocation(),Out,P);if(!Path||!Path->IsValid()||Path->IsPartial()){SiteFailure=FString::Printf(TEXT("full_path floor=%s nav=%s start=%s"),*Out.ToString(),*Projected.Location.ToString(),*P->GetActorLocation().ToString());return false;}return true;
}
void SiteVisuals(UWorld* W,FEquipmentSession& S){for(auto& T:S.Traps){T.Visual=Prop(W,TEXT("Trap"),T.Position);const FLinearColor Steel(.19,.22,.12);Part(T.Visual.Get(),TEXT("Cylinder"),FVector(.10,.10,.075),FVector(0,0,3.8),Steel);for(int32 I=0;I<3;++I)Part(T.Visual.Get(),TEXT("Cube"),FVector(.012,.012,.045),FVector((I-1)*2,0,9),Steel);if(T.State!=TEXT("Armed"))T.Visual->SetActorHiddenInGame(true);}
    for(auto& B:S.Supplies){B.Visual=Prop(W,TEXT("Supply"),B.Position);auto* C=NewObject<UStaticMeshComponent>(B.Visual.Get());B.Visual->AddInstanceComponent(C);auto* Mesh=LoadObject<UStaticMesh>(nullptr,TEXT("/Game/WW2City/Environment/Mesh/Props/SM_AmmoBox_01a.SM_AmmoBox_01a"));check(Mesh);C->SetStaticMesh(Mesh);C->SetupAttachment(B.Visual->GetRootComponent());C->SetCollisionEnabled(ECollisionEnabled::NoCollision);C->SetCanEverAffectNavigation(false);C->SetRelativeScale3D(FVector(.7));C->SetRelativeLocation(FVector(0,0,(Mesh->GetBounds().BoxExtent.Z-Mesh->GetBounds().Origin.Z)*.7));C->RegisterComponent();}
}
bool SetupSites(UWorld* W,FEquipmentSession& S){if(S.Initialized)return true;const FVector TrapXY[]={FVector(6637.5,-20137.5,0),FVector(7637.5,-20487.5,0)};const FVector SupplyXY[]={FVector(1812.5,-21162.5,0),FVector(6062.5,-20462.5,0)};
    for(int32 I=0;I<2;++I)if(!Site(W,TrapXY[I],S.Traps[I].Position)||!Site(W,SupplyXY[I],S.Supplies[I].Position)){Event(W,TEXT("site_rejected"),FString::FromInt(I)+TEXT(" ")+SiteFailure);return false;}SiteVisuals(W,S);S.Initialized=true;InstallSight(W,S);for(const auto& T:S.Traps)Event(W,TEXT("trap_site_ready"),T.Id);for(const auto& B:S.Supplies)Event(W,TEXT("supply_site_ready"),B.Id);return true;
}
bool VisiblePoint(UWorld* W,ACharacter* P,const FVector& At,double Range,double Cosine){if(Dead(P)||FVector::Dist(P->GetActorLocation(),At)>Range)return false;FVector Eye;FRotator View;P->GetActorEyesViewPoint(Eye,View);if(P->IsPlayerControlled())if(auto* PC=UGameplayStatics::GetPlayerController(W,0))PC->GetPlayerViewPoint(Eye,View);const FVector Delta=At-Eye;if(FVector::DotProduct(View.Vector(),Delta.GetSafeNormal())<Cosine||CloudBlock(W,Eye,At))return false;FCollisionQueryParams Q(SCENE_QUERY_STAT(ParisEquipmentObserve),true,P);IgnoreProps(W,Q);FHitResult Hit;return !W->LineTraceSingleByChannel(Hit,Eye,At,ECC_Visibility,Q);}
FString Target(UWorld* W,FEquipmentSession& S){auto* P=UGameplayStatics::GetPlayerCharacter(W,0);if(Dead(P))return FString();for(const auto& T:S.Traps)if(T.State==TEXT("Armed")&&T.Discovered&&VisiblePoint(W,P,T.Position+FVector(0,0,10),165,.65))return T.Id;for(const auto& B:S.Supplies)if(VisiblePoint(W,P,B.Position+FVector(0,0,25),200,.8))return B.Id;return FString();}
void Evade(UWorld* W,FEquipmentSession& S,ACharacter* C,const FVector& Danger,double Until){auto* AI=Cast<AAIController>(C->GetController());if(!AI||!AI->GetBrainComponent()||Dead(C))return;for(const auto& E:S.Evades)if(E.Pawn==C)return;
    AI->GetBrainComponent()->PauseLogic(TEXT("Observed equipment hazard"));AI->StopMovement();if(auto* BB=AI->GetBlackboardComponent())BB->SetValueAsBool(TEXT("HasVisibleTarget"),false);FEvade E;E.Pawn=C;E.Until=Until;E.Paused=true;E.PreviousHold=Flag(AI,TEXT("CombatHold"));E.PreviousGeneration=Num(AI,TEXT("CombatGeneration"));if(auto* F=FindFProperty<FBoolProperty>(AI->GetClass(),TEXT("CombatHold")))F->SetPropertyValue_InContainer(AI,true);SetNum(AI,TEXT("CombatGeneration"),Num(C,TEXT("RestoreGeneration")));S.Evades.Add(E);
    auto* Nav=FNavigationSystem::GetCurrent<UNavigationSystemV1>(W);if(!Nav)return;const FVector Away=(C->GetActorLocation()-Danger).GetSafeNormal2D();for(const double Yaw:{0.,45.,-45.,90.,-90.}){const FVector Want=C->GetActorLocation()+Away.RotateAngleAxis(Yaw,FVector::UpVector)*450;FNavLocation P;if(!Nav->ProjectPointToNavigation(Want,P,FVector(50,50,150)))continue;auto* Path=Nav->FindPathToLocationSynchronously(W,C->GetActorLocation(),P.Location,C);if(!Path||!Path->IsValid()||Path->IsPartial())continue;bool Safe=true;for(int32 I=1;I<Path->PathPoints.Num();++I){const FVector A=Path->PathPoints[I-1],B=Path->PathPoints[I],AB=(B-A)*FVector(1,1,0);const double U=FMath::Clamp(FVector::DotProduct((Danger-A)*FVector(1,1,0),AB)/FMath::Max(1.,AB.SizeSquared()),0.,1.);if(FVector::Dist2D(A+AB*U,Danger)<FVector::Dist2D(C->GetActorLocation(),Danger)-20)Safe=false;}if(Safe){FCollisionQueryParams Q(SCENE_QUERY_STAT(ParisEvadeClearance),false,C);IgnoreProps(W,Q);const auto* Capsule=C->GetCapsuleComponent();FVector Previous=C->GetActorLocation();for(int32 I=1;I<Path->PathPoints.Num();++I){const FVector Next=Path->PathPoints[I]+FVector(0,0,Capsule->GetScaledCapsuleHalfHeight()+2);FHitResult Hit;if(W->SweepSingleByChannel(Hit,Previous,Next,FQuat::Identity,ECC_Pawn,FCollisionShape::MakeCapsule(Capsule->GetScaledCapsuleRadius(),Capsule->GetScaledCapsuleHalfHeight()),Q)){Safe=false;break;}Previous=Next;}}if(Safe){const auto Result=AI->MoveToLocation(P.Location,35,true,true,true,false,nullptr,false);Event(W,TEXT("native_evade"),C->GetName()+TEXT(" to ")+P.Location.ToString(),int32(Result));return;}}
    Event(W,TEXT("hazard_wait_no_safe_path"),C->GetName());
}
void HazardTick(UWorld* W,FEquipmentSession& S){const double Now=W->GetTimeSeconds();for(int32 I=S.Evades.Num()-1;I>=0;--I)if(Now>=S.Evades[I].Until||Dead(S.Evades[I].Pawn.Get())){if(auto* C=S.Evades[I].Pawn.Get())if(auto* AI=Cast<AAIController>(C->GetController()))if(AI->GetBrainComponent()){AI->StopMovement();if(auto* F=FindFProperty<FBoolProperty>(AI->GetClass(),TEXT("CombatHold")))F->SetPropertyValue_InContainer(AI,S.Evades[I].PreviousHold);SetNum(AI,TEXT("CombatGeneration"),S.Evades[I].PreviousGeneration);if(!Dead(C)&&AParisBridgeMission::Find(W)->AllowsPlay())AI->GetBrainComponent()->ResumeLogic(TEXT("Equipment hazard interval ended"));}S.Evades.RemoveAt(I);}
    for(auto* C:Combatants(W))if(!C->IsPlayerControlled()&&!Dead(C)){for(const auto& B:S.Balls)if(B.Kind==TEXT("Frag")&&VisiblePoint(W,C,B.Position,950,0))Evade(W,S,C,B.Position,Now+B.Fuse+.4);for(const auto& T:S.Traps)if(Num(C,TEXT("TeamId"))==0&&T.Discovered&&T.State==TEXT("Armed")&&FVector::Dist2D(C->GetActorLocation(),T.Position)<240)Evade(W,S,C,T.Position,Now+3);}
}
void TrapTick(UWorld* W,FEquipmentSession& S,float DT){auto* Player=UGameplayStatics::GetPlayerCharacter(W,0);for(auto& T:S.Traps)if(T.State==TEXT("Armed")){if(!T.Discovered)for(auto* C:Combatants(W))if(Num(C,TEXT("TeamId"))==0&&VisiblePoint(W,C,T.Position+FVector(0,0,10),650,.5)){T.Discovered=true;Event(W,TEXT("trap_discovered"),T.Id);break;}
        for(auto* C:Combatants(W))if(!Dead(C)&&Num(C,TEXT("TeamId"))==0&&FVector::Dist2D(C->GetActorLocation(),T.Position)<65&&FMath::Abs(C->GetActorLocation().Z-C->GetCapsuleComponent()->GetScaledCapsuleHalfHeight()-T.Position.Z)<80){T.State=TEXT("Spent");if(T.Visual.IsValid())T.Visual->SetActorHiddenInGame(true);Blast(W,T.Position+FVector(0,0,15),T.Id,350,140);Event(W,TEXT("trap_triggered"),T.Id);break;}}
    if(S.EHeld){const FString Current=Target(W,S);if(Current!=S.InteractId||Dead(Player)||Player->GetVelocity().Size()>20){S.EHeld=false;S.DisarmClock=0;S.InteractId.Empty();Notice(W,TEXT("DISARM CANCELLED"));return;}S.DisarmClock+=DT;if(S.DisarmClock>=2)for(auto& T:S.Traps)if(T.Id==S.InteractId&&T.State==TEXT("Armed")){T.State=TEXT("Disarmed");if(T.Visual.IsValid())T.Visual->SetActorHiddenInGame(true);Event(W,TEXT("trap_disarmed"),T.Id);S.EHeld=false;S.DisarmClock=0;S.InteractId.Empty();Notice(W,TEXT("TRAP DISARMED"));break;}}
}
void Supply(UWorld* W,FEquipmentSession& S,const FString& Id){auto* P=UGameplayStatics::GetPlayerCharacter(W,0);for(auto& B:S.Supplies)if(B.Id==Id){const int32 Room=FMath::Max(0,64-int32(Num(P,TEXT("ReserveAmmo"))));const int32 Amount=FMath::Min(Room,B.Remaining);if(!Amount){Notice(W,B.Remaining==0?TEXT("AMMO BOX EMPTY"):TEXT("RESERVE FULL"));return;}const double Reserve=Num(P,TEXT("ReserveAmmo"));if(!SetNum(P,TEXT("ReserveAmmo"),Reserve+Amount)){Notice(W,TEXT("SUPPLY REJECTED"));return;}B.Remaining-=Amount;S.Grant+=Amount;Event(W,TEXT("supply_grant"),B.Id,Amount);Notice(W,FString::Printf(TEXT("+%d RESERVE ROUNDS"),Amount));return;}}
bool WorldInput(UWorld* W,FEquipmentSession& S,const FInputKeyEventArgs& Params){if(Params.Key!=EKeys::E)return false;if(Params.Event==IE_Released){const bool Was=S.EHeld;S.EHeld=false;S.DisarmClock=0;S.InteractId.Empty();return Was;}if(Params.Event!=IE_Pressed)return false;S.InteractId=Target(W,S);if(S.InteractId.StartsWith(TEXT("Trap"))){S.EHeld=true;S.DisarmClock=0;return true;}if(S.InteractId.StartsWith(TEXT("Supply"))){Supply(W,S,S.InteractId);S.InteractId.Empty();return true;}return false;}
